{
  "expo": {
    "name": "ALIADO",
    "slug": "aliado",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aliado",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aliado.movil"
    },
    "android": {
      "package": "com.aliado.movil",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "ALIADO necesita acceso a tus fotos para adjuntarlas a una solicitud."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ]
  }
}
