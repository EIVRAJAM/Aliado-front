# URL base del servidor ALIADO, sin /api/v1.
# Ejemplo: http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=

# Versión de términos y tratamiento de datos aprobada para el registro.
# Sin este valor el registro permanece bloqueado.
EXPO_PUBLIC_TERMS_VERSION=

# Piloto Android FCM directo. Requiere reconstruir el APK.
EXPO_PUBLIC_ANDROID_PUSH_ENABLED=false
# ALIADO_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json
